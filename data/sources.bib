@inproceedings{peseyie_voiceless_2025,
	title = {Voiceless {Laterals} in {Hmar}},
	issn = {2472-7695},
	url = {https://ieeexplore.ieee.org/document/11385255/},
	doi = {10.1109/O-COCOSDA68185.2025.11385255},
	abstract = {The present work looks into the acoustics of voiced and voiceless laterals in Hmar. Voiceless laterals are rare crosslinguistically and are not well described. The waveforms show that voiced laterals in Hmar are fully voiced, but the voiceless laterals have a voiced portion just before the vowel and after the aspiration. The data collected from native Hmar speakers were analyzed. Acoustic measures such as duration, voicing, Harmonic-to-Noise Ratio (HNR), Standard Deviation (SD), intensity, the first four formant frequencies, kurtosis, skewness, and the Center of Gravity (CoG) were calculated, and the results showed that there is a significant difference in the voiced and voiceless laterals in Hmar. Further analyses using statistical methods were conducted to validate the findings.},
	urldate = {2026-03-13},
	booktitle = {2025 28th {Conference} of the {Oriental} {COCOSDA} {International} {Committee} for the {Co}-ordination and {Standardisation} of {Speech} {Databases} and {Assessment} {Techniques} ({O}-{COCOSDA})},
